# ─────────────────────────────────────────────────────────────
#  LearnMate – Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Flask secret key (generate a long random string)
SECRET_KEY=your-very-secret-flask-key-change-this

# ── IBM Watsonx.ai ────────────────────────────────────────────
IBM_API_KEY=your_api_key_here
IBM_PROJECT_ID=your_project_id_here
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── Optional: IBM Granite model override ─────────────────────
# Default: ibm/granite-3-3-8b-instruct
GRANITE_MODEL_ID=ibm/granite-4-h-small

# ── Database ─────────────────────────────────────────────────
# Default is SQLite in the project root (no change needed locally)
DATABASE_URL=sqlite:///learnmate.db
